<Window x:Class="VencordCustomManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Custom Vencord Manager"
        Width="1040"
        Height="800"
        MinWidth="1040"
        MaxWidth="1040"
        MinHeight="800"
        MaxHeight="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#050505"
        Foreground="#F4F4F5"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="0"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Color x:Key="Bg0">#050505</Color>
        <Color x:Key="Bg1">#080808</Color>
        <Color x:Key="Surface">#0D0D0D</Color>
        <Color x:Key="SurfaceRaised">#141414</Color>
        <Color x:Key="Border">#262626</Color>
        <Color x:Key="BorderSoft">#1C1C1C</Color>
        <Color x:Key="Text">#F4F4F5</Color>
        <Color x:Key="TextMuted">#A1A1AA</Color>
        <Color x:Key="TextSubtle">#71717A</Color>
        <Color x:Key="Accent">#F4F4F5</Color>
        <Color x:Key="AccentHover">#FFFFFF</Color>
        <Color x:Key="AccentSoft">#1A1A1A</Color>
        <Color x:Key="Success">#34D399</Color>
        <Color x:Key="SuccessSoft">#10251D</Color>
        <Color x:Key="Warning">#FBBF24</Color>
        <Color x:Key="WarningSoft">#2A2110</Color>
        <Color x:Key="Danger">#FB7185</Color>
        <Color x:Key="DangerSoft">#30161D</Color>
        <Color x:Key="FocusRing">#D4D4D8</Color>
        <Color x:Key="Inset">#090909</Color>

        <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0}" />
        <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaised}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
        <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource BorderSoft}" />
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
        <SolidColorBrush x:Key="TextSubtleBrush" Color="{StaticResource TextSubtle}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoft}" />
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
        <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoft}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
        <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoft}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
        <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoft}" />
        <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource FocusRing}" />
        <SolidColorBrush x:Key="InsetBrush" Color="{StaticResource Inset}" />

        <!-- No stock button chrome: every button in the app uses this surface. -->
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Root"
                                    CornerRadius="8"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}" />
                                    <Border x:Name="HoverWash" CornerRadius="7" Background="#0FFFFFFF" Opacity="0" />
                                </Grid>
                            </Border>
                            <Border x:Name="FocusRing"
                                    Margin="-2"
                                    CornerRadius="10"
                                    BorderBrush="{StaticResource FocusRingBrush}"
                                    BorderThickness="2"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverWash" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransformOrigin" Value="0.5,0.5" />
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.985" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Foreground" Value="#71717A" />
                                <Setter TargetName="Root" Property="Background" Value="#101010" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#242424" />
                                <Setter TargetName="HoverWash" Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#090909" />
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="#5A2933" />
            <Setter Property="Foreground" Value="#FFB7BF" />
        </Style>

        <Style x:Key="CompactGhostButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <Style x:Key="WindowControlButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>

        <Style x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Foreground" Value="#D4D4D8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Root" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="FocusRing"
                                    Margin="1"
                                    CornerRadius="7"
                                    BorderBrush="{StaticResource FocusRingBrush}"
                                    BorderThickness="2"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E5484D" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#B9353A" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented control used instead of a native ComboBox. -->
        <Style x:Key="SegmentRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Root"
                                    CornerRadius="7"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="FocusRing"
                                    Margin="-2"
                                    CornerRadius="9"
                                    BorderBrush="{StaticResource FocusRingBrush}"
                                    BorderThickness="2"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#161616" />
                                <Setter Property="Foreground" Value="#E4E4E7" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#242424" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#3F3F46" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Background" Value="#18181B" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                            <Border x:Name="PART_Track" CornerRadius="3" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3" />
                            <Border x:Name="IndeterminateIndicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3"
                                    Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Opacity" Value="0" />
                                <Setter TargetName="IndeterminateIndicator" Property="Opacity" Value="0.42" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="IndeterminateStoryboard">
                                        <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="IndeterminateIndicator"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.32"
                                                             To="0.86"
                                                             Duration="0:0:0.65" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="IndeterminateStoryboard" />
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimal custom scrollbars used by the activity log. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#59595F" CornerRadius="5" Margin="2,0" MinHeight="28" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#0D0D0D" />
            <Setter Property="Foreground" Value="#D4D4D8" />
            <Setter Property="BorderBrush" Value="#27272A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowBorder"
            Background="{StaticResource Bg0Brush}"
            BorderBrush="#1F1F1F"
            BorderThickness="1"
            CornerRadius="12">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Fully custom title bar. -->
            <Grid Grid.Row="0"
                  Background="#080808"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="24"
                            Height="24"
                            CornerRadius="7"
                            Background="#111111"
                            BorderBrush="#262626"
                            BorderThickness="1">
                        <Grid>
                            <Ellipse Width="8" Height="8" Fill="#F4F4F5" />
                            <Ellipse Width="3" Height="3" Fill="#71717A" Margin="8,0,0,8" />
                        </Grid>
                    </Border>
                    <TextBlock Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="#F4F4F5"
                               Text="Custom Vencord Manager" />
                    <Border Margin="9,0,0,0"
                            Padding="7,3"
                            CornerRadius="6"
                            Background="#111111"
                            BorderBrush="#27272A"
                            BorderThickness="1">
                        <TextBlock x:Name="ManagerVersionText" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="v0.1.2" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,6,7,6">
                    <Button Style="{StaticResource WindowControlButton}" Content="&#xE921;" Click="MinimizeButton_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize window" />
                    <Button Style="{StaticResource CloseWindowButton}" Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="Close" AutomationProperties.Name="Close window" />
                </StackPanel>
                <Border Grid.ColumnSpan="2"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="#1C1C1C"
                        IsHitTestVisible="False" />
            </Grid>

            <Grid x:Name="LegacyDashboard" Grid.Row="1" Visibility="Collapsed">
                <Grid.Background>
                    <RadialGradientBrush Center="0.13,0.03" GradientOrigin="0.13,0.03" RadiusX="0.8" RadiusY="0.8">
                        <GradientStop Color="#111111" Offset="0" />
                        <GradientStop Color="#080808" Offset="0.34" />
                        <GradientStop Color="#050505" Offset="0.78" />
                    </RadialGradientBrush>
                </Grid.Background>

                <ScrollViewer x:Name="MainScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              PanningDeceleration="0.0015"
                              PanningRatio="1"
                              MouseWheel="SmoothScrollViewer_MouseWheel">
                    <Grid Margin="32,24,32,28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="220" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"
                                           Text="CUSTOM VENCORD MANAGER" />
                                <TextBlock Margin="0,5,0,0" FontSize="26" FontWeight="SemiBold" Text="Keep your client current." />
                                <TextBlock Margin="0,5,0,0"
                                           FontSize="13"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="Verified releases, per-client updates, and safe rollback." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ManagerUpdateButton"
                                        Margin="0,0,8,0"
                                        Visibility="Collapsed"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="ManagerUpdateButton_Click"
                                        Content="Update manager" />
                                <Button Style="{StaticResource ButtonBase}" Click="ViewRelease_Click" Content="GitHub releases  ↗" />
                            </StackPanel>
                        </Grid>

                        <!-- Main release card -->
                        <Border Grid.Row="2"
                                Background="#0A0A0A"
                                BorderBrush="#27272A"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="Release status" />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Border x:Name="StatusBadge"
                                                Padding="9,5"
                                                CornerRadius="8"
                                                Background="{StaticResource AccentSoftBrush}"
                                                BorderBrush="#3F3F46"
                                                BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{StaticResource AccentBrush}" />
                                                <TextBlock x:Name="StatusText" FontSize="11.5" FontWeight="SemiBold" Text="Checking for updates…" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="8,0,0,0"
                                                Padding="9,5"
                                                CornerRadius="8"
                                                Background="#111111"
                                                BorderBrush="#27272A"
                                                BorderThickness="1">
                                            <TextBlock x:Name="SelectedChannelText"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11.5"
                                                       Text="Auto channel" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="230" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="Selected client version" />
                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Installed" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" />
                                                <TextBlock x:Name="InstalledVersionText" Margin="0,2,0,0" Text="—" FontSize="24" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,4" HorizontalAlignment="Center" Foreground="#52525B" FontSize="18" Text="→" />
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Latest" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" />
                                                <TextBlock x:Name="LatestVersionText" Margin="0,2,0,0" Text="—" FontSize="24" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Button x:Name="PrimaryButton"
                                                Height="44"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="PrimaryButton_Click"
                                                Content="Install latest" />
                                        <Button x:Name="CheckButton"
                                                Margin="0,6,0,0"
                                                Style="{StaticResource GhostButton}"
                                                Click="CheckButton_Click"
                                                Content="Check again" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="4" Orientation="Horizontal">
                                    <Border Padding="8,4" CornerRadius="7" Background="#101010" BorderBrush="#262626" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Text="✓" />
                                            <TextBlock Margin="6,0,0,0" FontSize="10.8" Foreground="{StaticResource TextMutedBrush}" Text="SHA-256 verified" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="7,0,0,0" Padding="8,4" CornerRadius="7" Background="#101010" BorderBrush="#262626" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Text="↶" />
                                            <TextBlock Margin="6,0,0,0" FontSize="10.8" Foreground="{StaticResource TextMutedBrush}" Text="Rollback ready" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="7,0,0,0" Padding="8,4" CornerRadius="7" Background="#101010" BorderBrush="#262626" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Text="•" />
                                            <TextBlock Margin="6,0,0,0" FontSize="10.8" Foreground="{StaticResource TextMutedBrush}" Text="Per-client isolation" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Secondary cards -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.12*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="0.88*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="20">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="Included components" />
                                        <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextSubtleBrush}" Text="From latest manifest" />
                                    </Grid>
                                    <Grid Margin="0,17,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Foreground="{StaticResource TextMutedBrush}" Text="Vencord base" />
                                        <Border Grid.Row="0" Grid.Column="1" Background="#141414" CornerRadius="6" Padding="8,3">
                                            <TextBlock x:Name="VencordVersionText" FontSize="11.5" FontWeight="SemiBold" Text="—" />
                                        </Border>
                                        <TextBlock Grid.Row="2" Foreground="{StaticResource TextMutedBrush}" Text="OrionQuests" />
                                        <Border Grid.Row="2" Grid.Column="1" Background="#141414" CornerRadius="6" Padding="8,3">
                                            <TextBlock x:Name="OrionVersionText" FontSize="11.5" FontWeight="SemiBold" Text="—" />
                                        </Border>
                                        <TextBlock Grid.Row="4" Foreground="{StaticResource TextMutedBrush}" Text="NitroSniper" />
                                        <Border Grid.Row="4" Grid.Column="1" Background="#141414" CornerRadius="6" Padding="8,3">
                                            <TextBlock x:Name="NitroVersionText" FontSize="11.5" FontWeight="SemiBold" Text="—" />
                                        </Border>
                                        <TextBlock Grid.Row="6" Foreground="{StaticResource TextMutedBrush}" Text="Runtime plugin loader" />
                                        <Border Grid.Row="6" Grid.Column="1" Background="#10251D" CornerRadius="6" Padding="8,3">
                                            <TextBlock x:Name="LoaderStatusText" FontSize="11.5" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Text="—" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="20">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="Client controls" />
                                    <TextBlock Margin="0,5,0,0" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="Choose the Discord install the manager should modify." />

                                    <Border Margin="0,14,0,0" Padding="3" CornerRadius="8" Background="#090909" BorderBrush="#27272A" BorderThickness="1">
                                        <UniformGrid Columns="4">
                                            <RadioButton x:Name="BranchAuto" GroupName="DiscordBranch" Tag="auto" IsChecked="True" Style="{StaticResource SegmentRadio}" Content="Auto" Checked="BranchRadio_Checked" />
                                            <RadioButton x:Name="BranchStable" GroupName="DiscordBranch" Tag="stable" Style="{StaticResource SegmentRadio}" Content="Stable" Checked="BranchRadio_Checked" />
                                            <RadioButton x:Name="BranchPtb" GroupName="DiscordBranch" Tag="ptb" Style="{StaticResource SegmentRadio}" Content="PTB" Checked="BranchRadio_Checked" />
                                            <RadioButton x:Name="BranchCanary" GroupName="DiscordBranch" Tag="canary" Style="{StaticResource SegmentRadio}" Content="Canary" Checked="BranchRadio_Checked" />
                                        </UniformGrid>
                                    </Border>

                                    <StackPanel Margin="0,12,0,0">
                                        <Border x:Name="StableClientRow"
                                                Padding="10,8"
                                                CornerRadius="8"
                                                Background="{StaticResource InsetBrush}"
                                                BorderBrush="#262626"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse x:Name="StableClientDot" Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource TextSubtleBrush}" />
                                                <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Text="Discord Stable" />
                                                <Border Grid.Column="2" x:Name="StableClientStatusBadge" Padding="7,3" CornerRadius="6" Background="#141414" BorderBrush="#27272A" BorderThickness="1">
                                                    <TextBlock x:Name="StableClientStatusText" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="Checking…" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Border x:Name="PtbClientRow"
                                                Margin="0,6,0,0"
                                                Padding="10,8"
                                                CornerRadius="8"
                                                Background="{StaticResource InsetBrush}"
                                                BorderBrush="#262626"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse x:Name="PtbClientDot" Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource TextSubtleBrush}" />
                                                <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Text="Discord PTB" />
                                                <Border Grid.Column="2" x:Name="PtbClientStatusBadge" Padding="7,3" CornerRadius="6" Background="#141414" BorderBrush="#27272A" BorderThickness="1">
                                                    <TextBlock x:Name="PtbClientStatusText" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="Checking…" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Border x:Name="CanaryClientRow"
                                                Margin="0,6,0,0"
                                                Padding="10,8"
                                                CornerRadius="8"
                                                Background="{StaticResource InsetBrush}"
                                                BorderBrush="#262626"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse x:Name="CanaryClientDot" Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource TextSubtleBrush}" />
                                                <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Text="Discord Canary" />
                                                <Border Grid.Column="2" x:Name="CanaryClientStatusBadge" Padding="7,3" CornerRadius="6" Background="#141414" BorderBrush="#27272A" BorderThickness="1">
                                                    <TextBlock x:Name="CanaryClientStatusText" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="Checking…" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="RepairButton" Grid.Column="0" Style="{StaticResource ButtonBase}" Click="RepairButton_Click" Content="Repair" ToolTip="Redownload and verify the selected client's managed payload." />
                                        <Button x:Name="OpenPluginsButton" Grid.Column="2" Style="{StaticResource ButtonBase}" Click="OpenPluginsButton_Click" Content="Plugins folder" ToolTip="Open the shared Vencord runtime plugins folder." />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="OpenInstallButton" Grid.Column="0" Style="{StaticResource ButtonBase}" Click="OpenInstallButton_Click" Content="Install folder" ToolTip="Open the selected client's managed payload folder." />
                                        <Button x:Name="UninstallButton" Grid.Column="2" Style="{StaticResource DangerButton}" Click="UninstallButton_Click" Content="Uninstall" ToolTip="Remove Custom Vencord from the selected Discord client only." />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Activity card -->
                        <Border Grid.Row="6"
                                Background="#0A0A0A"
                                BorderBrush="{StaticResource BorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="11" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="11" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="#71717A" VerticalAlignment="Center" />
                                        <TextBlock Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" Text="Activity" />
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Border Padding="9,4"
                                                CornerRadius="7"
                                                Background="#111111"
                                                BorderBrush="#27272A"
                                                BorderThickness="1">
                                            <TextBlock x:Name="ProgressText"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="10.8"
                                                       Text="Ready" />
                                        </Border>
                                        <Button Margin="7,0,0,0"
                                                Style="{StaticResource CompactGhostButton}"
                                                Click="CopyActivityButton_Click"
                                                Content="Copy log"
                                                ToolTip="Copy the activity log to the clipboard." />
                                        <Button Margin="2,0,0,0"
                                                Style="{StaticResource CompactGhostButton}"
                                                Click="ClearActivityButton_Click"
                                                Content="Clear"
                                                ToolTip="Clear the visible activity log." />
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Grid.Row="2" x:Name="OperationProgressBar" Minimum="0" Maximum="100" Value="0" />
                                <Border Grid.Row="4"
                                        Padding="12,10,7,10"
                                        CornerRadius="16"
                                        Background="#070707"
                                        BorderBrush="#242424"
                                        BorderThickness="1">
                                    <ScrollViewer x:Name="ActivityScrollViewer"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  PanningMode="VerticalOnly"
                                                  PanningDeceleration="0.0015"
                                                  PanningRatio="1"
                                                  MouseWheel="SmoothScrollViewer_MouseWheel">
                                        <TextBlock x:Name="ActivityLogText"
                                                   TextWrapping="Wrap"
                                                   Foreground="#A1A1AA"
                                                   FontFamily="Consolas"
                                                   FontSize="11.2"
                                                   LineHeight="18" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- Custom modal overlay replaces native MessageBox UI. -->
                <Grid x:Name="DialogOverlay"
                      Visibility="Collapsed"
                      Background="#D9000000"
                      FocusManager.IsFocusScope="True"
                      KeyboardNavigation.TabNavigation="Cycle"
                      KeyboardNavigation.DirectionalNavigation="Cycle"
                      Panel.ZIndex="100">
                    <Border x:Name="DialogPanel"
                            Width="470"
                            MaxHeight="460"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Background="#0D0D0D"
                            BorderBrush="#2A2A2A"
                            BorderThickness="1"
                            CornerRadius="24"
                            Padding="20">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="DialogScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border x:Name="DialogIconSurface"
                                    Width="44"
                                    Height="44"
                                    HorizontalAlignment="Left"
                                    CornerRadius="16"
                                    Background="{StaticResource AccentSoftBrush}"
                                    BorderBrush="#27272A"
                                    BorderThickness="1">
                                <TextBlock x:Name="DialogIcon"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"
                                           Text="i" />
                            </Border>
                            <TextBlock x:Name="DialogTitle"
                                       Grid.Row="1"
                                       Margin="0,16,0,0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="Dialog title" />
                            <ScrollViewer Grid.Row="3"
                                          Margin="0,8,0,0"
                                          MaxHeight="245"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="DialogMessage"
                                           Padding="0,0,6,0"
                                           TextWrapping="Wrap"
                                           FontSize="12.5"
                                           LineHeight="19"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="Dialog message" />
                            </ScrollViewer>
                            <Grid Grid.Row="4" Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="DialogCancelButton"
                                        Grid.Column="0"
                                        Style="{StaticResource ButtonBase}"
                                        Click="DialogCancelButton_Click"
                                        IsCancel="True"
                                        Content="Cancel" />
                                <Button x:Name="DialogConfirmButton"
                                        Grid.Column="2"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="DialogConfirmButton_Click"
                                        Content="Continue" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <wv2:WebView2 x:Name="WebDashboard"
                          Grid.Row="1"
                          Visibility="Collapsed" />

            <!--
                Deliberate startup surface. The full legacy dashboard is reserved for a
                genuine WebView2 failure; it is never shown transiently while React boots.
            -->
            <Grid x:Name="StartupSurface"
                  Grid.Row="1"
                  Background="#050505"
                  Panel.ZIndex="200">
                <Grid.Resources>
                    <Style x:Key="StartupSkeletonBlock" TargetType="Border">
                        <Setter Property="Background" Value="#111111" />
                        <Setter Property="BorderBrush" Value="#1F1F1F" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="7" />
                        <Setter Property="Opacity" Value="0.88" />
                    </Style>
                    <Style x:Key="StartupSkeletonCard" TargetType="Border">
                        <Setter Property="Background" Value="#090909" />
                        <Setter Property="BorderBrush" Value="#1F1F1F" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="18" />
                    </Style>
                </Grid.Resources>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="214" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Instant native skeleton mirrors the React dashboard geometry. -->
                <Border Grid.Column="0"
                        Background="#070707"
                        BorderBrush="#1B1B1B"
                        BorderThickness="0,0,1,0"
                        Padding="16,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="15" Style="{StaticResource StartupSkeletonBlock}" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Border Width="104" Height="11" HorizontalAlignment="Left" CornerRadius="5" Style="{StaticResource StartupSkeletonBlock}" />
                                <Border Width="68" Height="7" Margin="0,7,0,0" HorizontalAlignment="Left" CornerRadius="4" Style="{StaticResource StartupSkeletonBlock}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="7" CornerRadius="4" Style="{StaticResource StartupSkeletonBlock}" />
                            <Border Grid.Column="2" Height="1" VerticalAlignment="Center" Background="#181818" />
                        </Grid>

                        <Border Grid.Row="4"
                                Padding="4"
                                CornerRadius="16"
                                Background="#050505"
                                BorderBrush="#1C1C1C"
                                BorderThickness="1">
                            <StackPanel>
                                <Grid Height="68" Margin="6,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" VerticalAlignment="Center" CornerRadius="11" Style="{StaticResource StartupSkeletonBlock}" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Border Width="58" Height="9" HorizontalAlignment="Left" Style="{StaticResource StartupSkeletonBlock}" />
                                        <Border Width="88" Height="7" Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource StartupSkeletonBlock}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Height="68" Margin="6,6,6,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" VerticalAlignment="Center" CornerRadius="11" Style="{StaticResource StartupSkeletonBlock}" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Border Width="58" Height="9" HorizontalAlignment="Left" Style="{StaticResource StartupSkeletonBlock}" />
                                        <Border Width="88" Height="7" Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource StartupSkeletonBlock}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Height="68" Margin="6,6,6,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" VerticalAlignment="Center" CornerRadius="11" Style="{StaticResource StartupSkeletonBlock}" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Border Width="58" Height="9" HorizontalAlignment="Left" Style="{StaticResource StartupSkeletonBlock}" />
                                        <Border Width="88" Height="7" Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource StartupSkeletonBlock}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="6" Padding="13" CornerRadius="16" Style="{StaticResource StartupSkeletonCard}">
                            <StackPanel>
                                <Border Width="96" Height="9" HorizontalAlignment="Left" Style="{StaticResource StartupSkeletonBlock}" />
                                <Border Height="7" Margin="0,10,0,0" HorizontalAlignment="Stretch" Style="{StaticResource StartupSkeletonBlock}" />
                                <Border Width="118" Height="7" Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource StartupSkeletonBlock}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" IsHitTestVisible="False">
                    <StackPanel Margin="16,20,16,24">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="106" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Width="130" Height="7" HorizontalAlignment="Left" Style="{StaticResource StartupSkeletonBlock}" />
                                <Border Width="260" Height="24" Margin="0,14,0,0" HorizontalAlignment="Left" CornerRadius="8" Style="{StaticResource StartupSkeletonBlock}" />
                                <Border Width="285" Height="9" Margin="0,11,0,0" HorizontalAlignment="Left" Style="{StaticResource StartupSkeletonBlock}" />
                            </StackPanel>
                            <Border Grid.Column="1" Height="40" CornerRadius="12" Style="{StaticResource StartupSkeletonBlock}" />
                        </Grid>

                        <Border Margin="0,20,0,0" Padding="20" CornerRadius="20" Style="{StaticResource StartupSkeletonCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="126" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Border Width="150" Height="29" HorizontalAlignment="Left" CornerRadius="15" Style="{StaticResource StartupSkeletonBlock}" />
                                        <Border Width="390" Height="24" Margin="0,20,0,0" HorizontalAlignment="Left" CornerRadius="8" Style="{StaticResource StartupSkeletonBlock}" />
                                        <Border Width="425" Height="9" Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource StartupSkeletonBlock}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Height="58" CornerRadius="16" Style="{StaticResource StartupSkeletonBlock}" />
                                </Grid>

                                <Border Margin="0,24,0,0" Padding="18" CornerRadius="16" Background="#080808" BorderBrush="#1D1D1D" BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <Border Width="62" Height="7" HorizontalAlignment="Left" Style="{StaticResource StartupSkeletonBlock}" />
                                                <Border Width="116" Height="30" Margin="0,10,0,0" HorizontalAlignment="Left" CornerRadius="8" Style="{StaticResource StartupSkeletonBlock}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,7" Style="{StaticResource StartupSkeletonBlock}" />
                                            <StackPanel Grid.Column="2">
                                                <Border Width="88" Height="7" HorizontalAlignment="Left" Style="{StaticResource StartupSkeletonBlock}" />
                                                <Border Width="116" Height="30" Margin="0,10,0,0" HorizontalAlignment="Left" CornerRadius="8" Style="{StaticResource StartupSkeletonBlock}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,20,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Height="56" CornerRadius="12" Style="{StaticResource StartupSkeletonBlock}" />
                                            <Border Grid.Column="2" Height="56" CornerRadius="12" Style="{StaticResource StartupSkeletonBlock}" />
                                            <Border Grid.Column="4" Height="56" CornerRadius="12" Style="{StaticResource StartupSkeletonBlock}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Height="52" CornerRadius="12" Style="{StaticResource StartupSkeletonBlock}" />
                                    <Border Grid.Column="2" Height="52" CornerRadius="12" Style="{StaticResource StartupSkeletonBlock}" />
                                </Grid>
                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Height="7" Style="{StaticResource StartupSkeletonBlock}" />
                                    <Border Grid.Column="2" Height="7" Style="{StaticResource StartupSkeletonBlock}" />
                                </Grid>
                                <Border Height="6" Margin="0,8,0,0" CornerRadius="3" Style="{StaticResource StartupSkeletonBlock}" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="0.92*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" MinHeight="260" Padding="20" Style="{StaticResource StartupSkeletonCard}">
                                <StackPanel>
                                    <Border Width="130" Height="11" HorizontalAlignment="Left" Style="{StaticResource StartupSkeletonBlock}" />
                                    <Border Width="190" Height="7" Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource StartupSkeletonBlock}" />
                                    <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Grid.Column="0" Height="54" Style="{StaticResource StartupSkeletonBlock}" /><Border Grid.Column="2" Height="54" Style="{StaticResource StartupSkeletonBlock}" /></Grid>
                                    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Grid.Column="0" Height="54" Style="{StaticResource StartupSkeletonBlock}" /><Border Grid.Column="2" Height="54" Style="{StaticResource StartupSkeletonBlock}" /></Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" MinHeight="260" Padding="20" Style="{StaticResource StartupSkeletonCard}">
                                <StackPanel>
                                    <Border Width="138" Height="11" HorizontalAlignment="Left" Style="{StaticResource StartupSkeletonBlock}" />
                                    <Border Width="180" Height="7" Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource StartupSkeletonBlock}" />
                                    <Border Height="54" Margin="0,16,0,0" Style="{StaticResource StartupSkeletonBlock}" />
                                    <Border Height="54" Margin="0,10,0,0" Style="{StaticResource StartupSkeletonBlock}" />
                                    <Border Height="54" Margin="0,10,0,0" Style="{StaticResource StartupSkeletonBlock}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,16,0,0" Height="180" Padding="20" Style="{StaticResource StartupSkeletonCard}">
                            <StackPanel>
                                <Border Width="110" Height="11" HorizontalAlignment="Left" Style="{StaticResource StartupSkeletonBlock}" />
                                <Border Height="110" Margin="0,16,0,0" Style="{StaticResource StartupSkeletonBlock}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

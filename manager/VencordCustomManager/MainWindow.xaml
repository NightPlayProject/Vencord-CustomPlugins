<Window x:Class="VencordCustomManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Custom Vencord Manager"
        Width="1040"
        Height="760"
        MinWidth="920"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#090B10"
        Foreground="#F4F6FA"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="6"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Color x:Key="Bg0">#090B10</Color>
        <Color x:Key="Bg1">#0E1118</Color>
        <Color x:Key="Surface">#121721</Color>
        <Color x:Key="SurfaceRaised">#171D29</Color>
        <Color x:Key="Border">#262D3A</Color>
        <Color x:Key="BorderSoft">#1E2530</Color>
        <Color x:Key="Text">#F4F6FA</Color>
        <Color x:Key="TextMuted">#929CAB</Color>
        <Color x:Key="TextSubtle">#687384</Color>
        <Color x:Key="Accent">#8795FF</Color>
        <Color x:Key="AccentHover">#9BA6FF</Color>
        <Color x:Key="AccentSoft">#1D244A</Color>
        <Color x:Key="Success">#58C995</Color>
        <Color x:Key="SuccessSoft">#132A25</Color>
        <Color x:Key="Warning">#F0B45B</Color>
        <Color x:Key="WarningSoft">#2C2518</Color>
        <Color x:Key="Danger">#F07B87</Color>
        <Color x:Key="DangerSoft">#321B21</Color>

        <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0}" />
        <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaised}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
        <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource BorderSoft}" />
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
        <SolidColorBrush x:Key="TextSubtleBrush" Color="{StaticResource TextSubtle}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoft}" />
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
        <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoft}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
        <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoft}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
        <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoft}" />

        <!-- No stock button chrome: every button in the app uses this surface. -->
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                                <Border x:Name="HoverWash" CornerRadius="7" Background="#0FFFFFFF" Opacity="0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverWash" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransformOrigin" Value="0.5,0.5" />
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.985" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#090B10" />
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="#5A2933" />
            <Setter Property="Foreground" Value="#FFB7BF" />
        </Style>

        <Style x:Key="WindowControlButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>

        <Style x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Foreground" Value="#C8CED8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E5484D" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented control used instead of a native ComboBox. -->
        <Style x:Key="SegmentRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#171E29" />
                                <Setter Property="Foreground" Value="#DCE2EC" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#252C3A" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#384153" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Background" Value="#1B2230" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                            <Border x:Name="PART_Track" CornerRadius="3" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimal custom scrollbars used by the activity log. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#394252" CornerRadius="4" Margin="2,0" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowBorder"
            Background="{StaticResource Bg0Brush}"
            BorderBrush="#242B37"
            BorderThickness="1"
            CornerRadius="12">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Fully custom title bar. -->
            <Grid Grid.Row="0"
                  Background="#0B0E14"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource AccentSoftBrush}">
                        <Grid>
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" />
                            <Ellipse Width="3" Height="3" Fill="White" Margin="8,0,0,8" />
                        </Grid>
                    </Border>
                    <TextBlock Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="#DDE2EA"
                               Text="Custom Vencord Manager" />
                    <Border Margin="9,0,0,0"
                            Padding="7,3"
                            CornerRadius="6"
                            Background="#171C25"
                            BorderBrush="#252C38"
                            BorderThickness="1">
                        <TextBlock x:Name="ManagerVersionText" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="v0.1.0" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,6,7,6">
                    <Button Style="{StaticResource WindowControlButton}" Content="&#xE921;" Click="MinimizeButton_Click" />
                    <Button x:Name="MaximizeWindowButton" Style="{StaticResource WindowControlButton}" Content="&#xE922;" Click="MaximizeButton_Click" />
                    <Button Style="{StaticResource CloseWindowButton}" Content="&#xE8BB;" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.Background>
                    <RadialGradientBrush Center="0.13,0.03" GradientOrigin="0.13,0.03" RadiusX="0.8" RadiusY="0.8">
                        <GradientStop Color="#182042" Offset="0" />
                        <GradientStop Color="#0E1119" Offset="0.34" />
                        <GradientStop Color="#090B10" Offset="0.78" />
                    </RadialGradientBrush>
                </Grid.Background>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="34,28,34,30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="220" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="28" FontWeight="SemiBold" Text="Keep your client current." />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="13.5"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="Verified releases, safe rollback, and one-click repairs from NightPlayProject." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ManagerUpdateButton"
                                        Margin="0,0,8,0"
                                        Visibility="Collapsed"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="ManagerUpdateButton_Click"
                                        Content="Update manager" />
                                <Button Style="{StaticResource ButtonBase}" Click="ViewRelease_Click" Content="GitHub releases  ↗" />
                            </StackPanel>
                        </Grid>

                        <!-- Main release card -->
                        <Border Grid.Row="2"
                                Background="#E6121721"
                                BorderBrush="#303849"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="StatusBadge"
                                                Padding="9,5"
                                                CornerRadius="8"
                                                Background="{StaticResource AccentSoftBrush}"
                                                BorderBrush="#344178"
                                                BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{StaticResource AccentBrush}" />
                                                <TextBlock x:Name="StatusText" FontSize="11.5" FontWeight="SemiBold" Text="Checking for updates…" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSubtleBrush}"
                                                   FontSize="11.5"
                                                   Text="Stable channel" />
                                    </StackPanel>

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Installed" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                            <TextBlock x:Name="InstalledVersionText" Margin="0,3,0,0" Text="—" FontSize="25" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,5" HorizontalAlignment="Center" Foreground="#566175" FontSize="18" Text="→" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Latest" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                            <TextBlock x:Name="LatestVersionText" Margin="0,3,0,0" Text="—" FontSize="25" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Width="230" VerticalAlignment="Center">
                                    <Button x:Name="PrimaryButton"
                                            Height="44"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="PrimaryButton_Click"
                                            Content="Install latest" />
                                    <Button x:Name="CheckButton"
                                            Margin="0,8,0,0"
                                            Height="38"
                                            Style="{StaticResource GhostButton}"
                                            Click="CheckButton_Click"
                                            Content="Check again" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Secondary cards -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.12*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="0.88*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="20">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="Included components" />
                                        <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextSubtleBrush}" Text="From latest manifest" />
                                    </Grid>
                                    <Grid Margin="0,17,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Foreground="{StaticResource TextMutedBrush}" Text="Vencord base" />
                                        <Border Grid.Row="0" Grid.Column="1" Background="#1A202B" CornerRadius="6" Padding="8,3">
                                            <TextBlock x:Name="VencordVersionText" FontSize="11.5" FontWeight="SemiBold" Text="—" />
                                        </Border>
                                        <TextBlock Grid.Row="2" Foreground="{StaticResource TextMutedBrush}" Text="OrionQuests" />
                                        <Border Grid.Row="2" Grid.Column="1" Background="#1A202B" CornerRadius="6" Padding="8,3">
                                            <TextBlock x:Name="OrionVersionText" FontSize="11.5" FontWeight="SemiBold" Text="—" />
                                        </Border>
                                        <TextBlock Grid.Row="4" Foreground="{StaticResource TextMutedBrush}" Text="NitroSniper" />
                                        <Border Grid.Row="4" Grid.Column="1" Background="#1A202B" CornerRadius="6" Padding="8,3">
                                            <TextBlock x:Name="NitroVersionText" FontSize="11.5" FontWeight="SemiBold" Text="—" />
                                        </Border>
                                        <TextBlock Grid.Row="6" Foreground="{StaticResource TextMutedBrush}" Text="Runtime plugin loader" />
                                        <Border Grid.Row="6" Grid.Column="1" Background="#16241F" CornerRadius="6" Padding="8,3">
                                            <TextBlock x:Name="LoaderStatusText" FontSize="11.5" Foreground="#8CE3B8" FontWeight="SemiBold" Text="—" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="20">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="Client controls" />
                                    <TextBlock Margin="0,5,0,0" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="Choose the Discord install the manager should modify." />

                                    <Border Margin="0,14,0,0" Padding="3" CornerRadius="8" Background="#0D1118" BorderBrush="#222A36" BorderThickness="1">
                                        <UniformGrid Columns="4">
                                            <RadioButton x:Name="BranchAuto" GroupName="DiscordBranch" Tag="auto" IsChecked="True" Style="{StaticResource SegmentRadio}" Content="Auto" />
                                            <RadioButton x:Name="BranchStable" GroupName="DiscordBranch" Tag="stable" Style="{StaticResource SegmentRadio}" Content="Stable" />
                                            <RadioButton x:Name="BranchPtb" GroupName="DiscordBranch" Tag="ptb" Style="{StaticResource SegmentRadio}" Content="PTB" />
                                            <RadioButton x:Name="BranchCanary" GroupName="DiscordBranch" Tag="canary" Style="{StaticResource SegmentRadio}" Content="Canary" />
                                        </UniformGrid>
                                    </Border>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="RepairButton" Grid.Column="0" Style="{StaticResource ButtonBase}" Click="RepairButton_Click" Content="Repair" />
                                        <Button x:Name="OpenPluginsButton" Grid.Column="2" Style="{StaticResource ButtonBase}" Click="OpenPluginsButton_Click" Content="Plugins folder" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="OpenInstallButton" Grid.Column="0" Style="{StaticResource ButtonBase}" Click="OpenInstallButton_Click" Content="Install folder" />
                                        <Button x:Name="UninstallButton" Grid.Column="2" Style="{StaticResource DangerButton}" Click="UninstallButton_Click" Content="Uninstall" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Activity card -->
                        <Border Grid.Row="6"
                                Background="#D90E121A"
                                BorderBrush="{StaticResource BorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="11" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="11" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="#5E6A7E" VerticalAlignment="Center" />
                                        <TextBlock Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" Text="Activity" />
                                    </StackPanel>
                                    <TextBlock x:Name="ProgressText"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11.5"
                                               Text="Ready" />
                                </Grid>
                                <ProgressBar Grid.Row="2" x:Name="OperationProgressBar" Minimum="0" Maximum="100" Value="0" />
                                <ScrollViewer x:Name="ActivityScrollViewer"
                                              Grid.Row="4"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock x:Name="ActivityLogText"
                                               TextWrapping="Wrap"
                                               Foreground="#9FAABA"
                                               FontFamily="Consolas"
                                               FontSize="11.5"
                                               LineHeight="18" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- Custom modal overlay replaces native MessageBox UI. -->
                <Grid x:Name="DialogOverlay"
                      Visibility="Collapsed"
                      Background="#B8000000"
                      Panel.ZIndex="100">
                    <Border Width="430"
                            MaxHeight="430"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Background="#171C25"
                            BorderBrush="#333C4B"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="24">
                        <StackPanel>
                            <Border x:Name="DialogIconSurface"
                                    Width="38"
                                    Height="38"
                                    HorizontalAlignment="Left"
                                    CornerRadius="10"
                                    Background="{StaticResource AccentSoftBrush}">
                                <TextBlock x:Name="DialogIcon"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"
                                           Text="i" />
                            </Border>
                            <TextBlock x:Name="DialogTitle"
                                       Margin="0,16,0,0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="Dialog title" />
                            <TextBlock x:Name="DialogMessage"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       FontSize="12.5"
                                       LineHeight="19"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="Dialog message" />
                            <Grid Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="DialogCancelButton"
                                        Grid.Column="0"
                                        Style="{StaticResource ButtonBase}"
                                        Click="DialogCancelButton_Click"
                                        Content="Cancel" />
                                <Button x:Name="DialogConfirmButton"
                                        Grid.Column="2"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="DialogConfirmButton_Click"
                                        Content="Continue" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
